# ──────────────────────────────────────────────
# Market Alert Bot — Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# Groq API
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Telegram Bot API (for text messages)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Telegram MTProto (for voice calls via Account A)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_A=+918446614102
TELEGRAM_PHONE_B=+918087349105

# Logging
LOG_LEVEL=INFO
