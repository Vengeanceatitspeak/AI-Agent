# JARVIS Environment Variables
# Copy this to .env and fill in your values. Never commit .env!

# LLM API Keys (provide at least one)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Ollama (local, no key needed — just the URL)
OLLAMA_BASE_URL=http://localhost:11434

# Workspace root for filesystem server
JARVIS_WORKSPACE=~/jarvis-workspace

# Market data (optional)
MARKET_SERVER_TOKEN=

# API auth token (auto-generated on first run if not set)
JARVIS_API_TOKEN=

# Data directory (default: ~/.jarvis/data)
JARVIS_DATA_DIR=

# Log level (DEBUG, INFO, WARNING, ERROR)
JARVIS_LOG_LEVEL=INFO
